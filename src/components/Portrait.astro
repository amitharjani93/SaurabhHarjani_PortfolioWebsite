---
/**
 * Portrait frame.
 *
 * When `site.assets.portrait` is set, the photograph is rendered. When it is
 * not, an intentional typographic panel takes its place — the monogram on ink,
 * framed by the same bronze rule used elsewhere. No stock photograph and no
 * AI-generated likeness is ever substituted for a real portrait.
 */
import { site } from '../config/site';
import { url } from '../lib/url';

interface Props {
  /** Tailwind aspect ratio class. */
  ratio?: string;
  class?: string;
  loading?: 'eager' | 'lazy';
}

const { ratio = 'aspect-[4/5]', class: className = '', loading = 'lazy' } = Astro.props;
const portrait = site.assets.portrait;
---

<figure class:list={['portrait', ratio, className]}>
  {
    portrait ? (
      <img
        src={url(portrait)}
        alt={site.assets.portraitAlt}
        loading={loading}
        decoding="async"
        width="800"
        height="1000"
        class="h-full w-full object-cover"
      />
    ) : (
      <div class="portrait__placeholder" role="img" aria-label={`${site.name}, ${site.title}`}>
        <span class="portrait__monogram" aria-hidden="true">
          <span>S</span>
          <span class="portrait__rule" />
          <span>H</span>
        </span>
        <span class="portrait__caption">
          {site.name}
          <span class="portrait__role">{site.title}</span>
        </span>
      </div>
    )
  }
</figure>

<style>
  .portrait {
    position: relative;
    overflow: hidden;
    background-color: var(--color-stone-100);
  }

  /* A single bronze rule along the top edge, echoing the mark. */
  .portrait::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 4rem;
    height: 2px;
    background-color: var(--color-bronze-500);
    z-index: 2;
  }

  .portrait__placeholder {
    display: flex;
    height: 100%;
    width: 100%;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2.25rem;
    background-color: var(--color-ink-800);
    background-image: linear-gradient(to right, rgb(255 255 255 / 0.05) 1px, transparent 1px);
    background-size: 33.333% 100%;
    color: var(--color-paper);
    padding: 2rem;
    text-align: center;
  }

  .portrait__monogram {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 7vw, 4rem);
    font-weight: 400;
    line-height: 0.85;
  }

  .portrait__rule {
    display: block;
    width: 1px;
    height: 1.3em;
    background-color: var(--color-bronze-500);
  }

  .portrait__caption {
    display: grid;
    gap: 0.6rem;
    font-size: var(--text-caption);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-paper) 82%, transparent);
  }

  .portrait__role {
    font-size: var(--text-micro);
    letter-spacing: 0.22em;
    color: var(--color-bronze-400);
  }
</style>
