---
/**
 * The identity mark, rebuilt typographically from the supplied artwork.
 *
 * The source logo is a raster JPEG (public/brand/), which would blur at small
 * sizes and carries a white box that fights the ivory background. Rendering the
 * lockup in live type keeps it sharp at every size, lets it invert cleanly on
 * ink, costs no extra network request, and stays legible to search engines and
 * screen readers. Swap in an SVG here if a vector export is produced later.
 */
import { site } from '../config/site';

interface Props {
  variant?: 'inline' | 'stacked' | 'monogram';
  tone?: 'ink' | 'inverse';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
  /** Set on the page that the logo links to, so it is not a self-link. */
  asLink?: boolean;
}

const { variant = 'inline', tone = 'ink', size = 'md', class: className = '' } = Astro.props;

const scale = {
  sm: { mono: '0.95rem', word: '0.6875rem', tag: '0.5rem' },
  md: { mono: '1.2rem', word: '0.8125rem', tag: '0.5625rem' },
  lg: { mono: '2.1rem', word: '1.125rem', tag: '0.6875rem' },
}[size];

const primary = tone === 'inverse' ? 'var(--color-paper)' : 'var(--color-ink-800)';
const secondary = tone === 'inverse' ? 'color-mix(in srgb, var(--color-paper) 62%, transparent)' : 'var(--color-muted)';
---

<span
  class:list={['logo', `logo--${variant}`, className]}
  style={`--logo-mono:${scale.mono};--logo-word:${scale.word};--logo-tag:${scale.tag};--logo-primary:${primary};--logo-secondary:${secondary};`}
>
  <span class="logo__monogram" aria-hidden="true">
    <span class="logo__initial">S</span>
    <span class="logo__rule"></span>
    <span class="logo__initial">H</span>
  </span>

  {
    variant === 'monogram' ? (
      /* The initials alone carry no accessible name, so supply one. */
      <span class="sr-only">{site.name}</span>
    ) : (
      <span class="logo__words">
        <span class="logo__wordmark">{site.name}</span>
        <span class="logo__tagline">{site.tagline}</span>
      </span>
    )
  }
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--logo-primary);
    line-height: 1;
  }

  .logo--stacked {
    flex-direction: column;
    gap: 0.9rem;
    text-align: center;
  }

  .logo__monogram {
    display: inline-flex;
    align-items: center;
    gap: 0.42em;
    font-family: var(--font-display);
    font-size: var(--logo-mono);
    font-weight: 500;
    letter-spacing: 0.02em;
    flex: none;
  }

  .logo__initial {
    display: block;
    line-height: 0.85;
  }

  /* The single bronze rule from the artwork — the one ornament in the system. */
  .logo__rule {
    display: block;
    width: 1px;
    height: 1.32em;
    background-color: var(--color-bronze-500);
    flex: none;
  }

  .logo__words {
    display: flex;
    flex-direction: column;
    gap: 0.36em;
    min-width: 0;
  }

  .logo--stacked .logo__words {
    align-items: center;
    gap: 0.55em;
  }

  .logo__wordmark {
    font-family: var(--font-display);
    font-size: var(--logo-word);
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .logo__tagline {
    font-size: var(--logo-tag);
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--logo-secondary);
    white-space: nowrap;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }

  /* Below 380px the descriptor is dropped rather than allowed to wrap. */
  @media (max-width: 379px) {
    .logo--inline .logo__tagline {
      display: none;
    }
  }
</style>
