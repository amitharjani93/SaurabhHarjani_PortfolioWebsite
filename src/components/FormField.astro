---
interface Props {
  id: string;
  name: string;
  label: string;
  type?: 'text' | 'email' | 'tel' | 'textarea' | 'select' | 'radio' | 'checkbox';
  required?: boolean;
  optional?: boolean;
  placeholder?: string;
  autocomplete?: string;
  hint?: string;
  rows?: number;
  options?: { value: string; label: string }[];
  maxlength?: number;
  class?: string;
  value?: string;
}

const {
  id,
  name,
  label,
  type = 'text',
  required = false,
  optional = false,
  placeholder,
  autocomplete,
  hint,
  rows = 6,
  options = [],
  maxlength,
  class: className = '',
  value,
} = Astro.props;

const describedBy = [hint ? `${id}-hint` : null, `${id}-error`].filter(Boolean).join(' ');
---

<div class:list={['field', className]} data-field={name}>
  {
    type === 'radio' ? (
      <fieldset class="field__fieldset">
        <legend class="field__label">
          {label}
          {optional && <span class="field__optional">Optional</span>}
        </legend>
        {hint && (
          <p class="field__hint" id={`${id}-hint`}>
            {hint}
          </p>
        )}
        <div class="field__radios" role="radiogroup" aria-describedby={describedBy}>
          {options.map((option, i) => (
            <label class="radio">
              <input
                type="radio"
                name={name}
                value={option.value}
                checked={i === 0}
                class="radio__input"
                data-input
              />
              <span class="radio__box" aria-hidden="true" />
              <span class="radio__label">{option.label}</span>
            </label>
          ))}
        </div>
      </fieldset>
    ) : type === 'checkbox' ? (
      <label class="checkbox">
        <input
          type="checkbox"
          id={id}
          name={name}
          class="checkbox__input"
          aria-describedby={describedBy}
          data-input
        />
        <span class="checkbox__box" aria-hidden="true">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="m3.5 8.5 3 3 6-7" />
          </svg>
        </span>
        <span class="checkbox__label">
          <slot>{label}</slot>
        </span>
      </label>
    ) : (
      <>
        <label for={id} class="field__label">
          {label}
          {optional && <span class="field__optional">Optional</span>}
        </label>

        {hint && (
          <p class="field__hint" id={`${id}-hint`}>
            {hint}
          </p>
        )}

        {type === 'textarea' ? (
          <textarea
            id={id}
            name={name}
            rows={rows}
            placeholder={placeholder}
            maxlength={maxlength}
            required={required}
            aria-describedby={describedBy}
            class="field__control field__control--textarea"
            data-input
          />
        ) : type === 'select' ? (
          <div class="field__select-wrap">
            <select
              id={id}
              name={name}
              required={required}
              aria-describedby={describedBy}
              class="field__control field__control--select"
              data-input
            >
              <option value="">{placeholder ?? 'Please choose…'}</option>
              {options.map((option) => (
                <option value={option.value}>{option.label}</option>
              ))}
            </select>
            <svg
              class="field__chevron"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.25"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <path d="m6 9.5 6 6 6-6" />
            </svg>
          </div>
        ) : (
          <input
            id={id}
            name={name}
            type={type}
            placeholder={placeholder}
            autocomplete={autocomplete}
            maxlength={maxlength}
            required={required}
            value={value}
            aria-describedby={describedBy}
            class="field__control"
            data-input
          />
        )}
      </>
    )
  }

  <p class="field__error" id={`${id}-error`} data-error role="alert" hidden></p>
</div>

<style>
  .field {
    display: grid;
    gap: 0.55rem;
  }

  .field__fieldset {
    display: contents;
  }

  .field__label {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    font-size: var(--text-caption);
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-ink-700);
  }

  .field__optional {
    font-size: var(--text-micro);
    font-weight: 400;
    letter-spacing: 0.12em;
    color: var(--color-stone-400);
    text-transform: none;
  }

  .field__hint {
    font-size: var(--text-caption);
    color: var(--color-muted);
    max-width: 60ch;
  }

  .field__control {
    width: 100%;
    min-height: 3.125rem;
    padding: 0.85rem 1rem;
    background-color: var(--color-paper-raised);
    border: 1px solid var(--color-stone-300);
    border-radius: var(--radius-sm);
    color: var(--color-ink-800);
    font: inherit;
    font-size: 1rem; /* 16px keeps iOS from zooming on focus */
    line-height: 1.55;
    transition:
      border-color 220ms var(--ease-out-soft),
      box-shadow 220ms var(--ease-out-soft),
      background-color 220ms var(--ease-out-soft);
  }

  .field__control::placeholder {
    color: var(--color-stone-400);
  }

  .field__control:hover {
    border-color: var(--color-stone-400);
  }

  .field__control:focus {
    outline: none;
    border-color: var(--color-ink-700);
    box-shadow: inset 0 -2px 0 0 var(--color-bronze-500);
  }

  .field__control--textarea {
    min-height: 9rem;
    resize: vertical;
  }

  .field__select-wrap {
    position: relative;
  }

  .field__control--select {
    appearance: none;
    padding-right: 3rem;
    cursor: pointer;
  }

  .field__chevron {
    position: absolute;
    right: 1rem;
    top: 50%;
    width: 1.25rem;
    height: 1.25rem;
    transform: translateY(-50%);
    color: var(--color-muted);
    pointer-events: none;
  }

  /* --- Invalid state ------------------------------------------------------- */
  .field[data-invalid='true'] .field__control {
    border-color: #a4322c;
    background-color: #fdf7f6;
  }

  .field__error {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: var(--text-caption);
    color: #8c2b26;
  }

  .field__error[hidden] {
    display: none;
  }

  .field__error::before {
    content: '';
    flex: none;
    width: 0.5rem;
    height: 1px;
    margin-top: 0.65em;
    background-color: currentColor;
  }

  /* --- Radio --------------------------------------------------------------- */
  .field__radios {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .radio {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    min-height: 2.75rem;
    padding: 0.5rem 1.1rem 0.5rem 0.9rem;
    border: 1px solid var(--color-stone-300);
    border-radius: var(--radius-sm);
    background-color: var(--color-paper-raised);
    cursor: pointer;
    transition:
      border-color 220ms var(--ease-out-soft),
      background-color 220ms var(--ease-out-soft);
  }

  .radio:hover {
    border-color: var(--color-stone-400);
  }

  .radio__input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
  }

  .radio__box {
    position: relative;
    flex: none;
    width: 1rem;
    height: 1rem;
    border: 1px solid var(--color-stone-400);
    border-radius: 50%;
    transition: border-color 200ms var(--ease-out-soft);
  }

  .radio__box::after {
    content: '';
    position: absolute;
    inset: 3px;
    border-radius: 50%;
    background-color: var(--color-ink-800);
    transform: scale(0);
    transition: transform 220ms var(--ease-out-soft);
  }

  .radio__label {
    font-size: 0.9375rem;
    color: var(--color-ink-700);
  }

  .radio__input:checked ~ .radio__box {
    border-color: var(--color-ink-800);
  }

  .radio__input:checked ~ .radio__box::after {
    transform: scale(1);
  }

  .radio:has(.radio__input:checked) {
    border-color: var(--color-ink-800);
    background-color: color-mix(in srgb, var(--color-ink-800) 4%, transparent);
  }

  .radio__input:focus-visible ~ .radio__box {
    outline: 2px solid var(--color-bronze-600);
    outline-offset: 3px;
  }

  /* --- Checkbox ------------------------------------------------------------ */
  .checkbox {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: start;
    gap: 0.9rem;
    padding-block: 0.35rem;
    cursor: pointer;
  }

  .checkbox__input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
  }

  .checkbox__box {
    display: grid;
    place-items: center;
    width: 1.25rem;
    height: 1.25rem;
    margin-top: 0.15rem;
    border: 1px solid var(--color-stone-400);
    border-radius: var(--radius-sm);
    background-color: var(--color-paper-raised);
    color: transparent;
    transition:
      border-color 200ms var(--ease-out-soft),
      background-color 200ms var(--ease-out-soft),
      color 200ms var(--ease-out-soft);
  }

  .checkbox__box svg {
    width: 0.875rem;
    height: 0.875rem;
  }

  .checkbox__input:checked ~ .checkbox__box {
    border-color: var(--color-ink-800);
    background-color: var(--color-ink-800);
    color: var(--color-paper);
  }

  .checkbox__input:focus-visible ~ .checkbox__box {
    outline: 2px solid var(--color-bronze-600);
    outline-offset: 3px;
  }

  .checkbox__label {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-body);
  }

  .field[data-invalid='true'] .checkbox__box {
    border-color: #a4322c;
  }
</style>
