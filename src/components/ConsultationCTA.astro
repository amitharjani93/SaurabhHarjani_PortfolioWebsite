---
import Button from './Button.astro';
import Icon from './Icon.astro';
import { site, hasContactDetails, formattedAddress } from '../config/site';

interface Props {
  /** 'section' for a page section, 'band' for the compact end-of-page strip. */
  variant?: 'section' | 'band';
  heading?: string;
  lede?: string;
}

const {
  variant = 'section',
  heading = 'Start with a conversation.',
  lede = 'Describe the matter in a few lines. You will receive a reply setting out whether it falls within the practice, and if so, what a first consultation would involve.',
} = Astro.props;

const address = formattedAddress();
---

{
  variant === 'section' ? (
    <section class="bg-stone-50 py-(--spacing-section)">
      <div class="shell">
        <div class="grid gap-x-16 gap-y-12 lg:grid-cols-12">
          <div class="lg:col-span-6">
            <span class="eyebrow">Consultation</span>
            <h2 class="mt-6 text-h2 max-w-[15ch]">{heading}</h2>
            <p class="mt-7 max-w-[48ch] text-lead text-body">{lede}</p>

            <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-4">
              <Button href="/contact" variant="primary" size="lg">
                Request a Consultation
                <Icon name="arrow-right" size={17} />
              </Button>
              {site.contact.phone && (
                <Button href={`tel:${site.contact.phone.replace(/\s/g, '')}`} variant="secondary" size="lg">
                  {site.contact.phone}
                </Button>
              )}
            </div>
          </div>

          <div class="lg:col-span-5 lg:col-start-8">
            <ol class="grid gap-0">
              {[
                {
                  n: 'i',
                  t: 'Send a short summary',
                  d: 'A few lines about the situation and any deadline you are working to. Documents are not needed yet.',
                },
                {
                  n: 'ii',
                  t: 'Receive a reply',
                  d: site.consultation.responseNote,
                },
                {
                  n: 'iii',
                  t: 'Meet, in person or remotely',
                  d: 'A time is proposed by your preferred contact method. The scope and any fee are confirmed before work begins.',
                },
              ].map((step) => (
                <li class="consult-step">
                  <span class="consult-step__n" aria-hidden="true">
                    {step.n}
                  </span>
                  <div>
                    <h3 class="consult-step__t">{step.t}</h3>
                    <p class="consult-step__d">{step.d}</p>
                  </div>
                </li>
              ))}
            </ol>

            {hasContactDetails && (
              <address class="mt-8 grid gap-2.5 border-t border-stone-200 pt-7 text-sm not-italic text-body">
                {site.contact.email && (
                  <a href={`mailto:${site.contact.email}`} class="inline-flex items-center gap-3 hover:text-ink-800">
                    <Icon name="mail" size={16} class="text-bronze-600" />
                    {site.contact.email}
                  </a>
                )}
                {address.length > 0 && (
                  <span class="flex items-start gap-3">
                    <Icon name="pin" size={16} class="mt-1 shrink-0 text-bronze-600" />
                    <span>{address.join(', ')}</span>
                  </span>
                )}
                <span class="flex items-start gap-3 text-muted">
                  <Icon name="clock" size={16} class="mt-1 shrink-0 text-bronze-600" />
                  <span>{site.contact.availabilityNote}</span>
                </span>
              </address>
            )}
          </div>
        </div>
      </div>
    </section>
  ) : (
    <section class="border-t border-stone-200 bg-paper">
      <div class="shell">
        <div class="flex flex-col gap-7 py-(--spacing-section-sm) md:flex-row md:items-center md:justify-between md:gap-12">
          <div>
            <h2 class="text-h3 max-w-[20ch]">{heading}</h2>
            <p class="mt-3 max-w-[52ch] text-body">{lede}</p>
          </div>
          <Button href="/contact" variant="primary" size="lg" class="shrink-0 self-start md:self-auto">
            Request a Consultation
            <Icon name="arrow-right" size={17} />
          </Button>
        </div>
      </div>
    </section>
  )
}

<style>
  .consult-step {
    display: grid;
    grid-template-columns: 2.25rem 1fr;
    gap: 1rem;
    padding-block: 1.5rem;
    border-top: 1px solid var(--color-stone-200);
  }

  .consult-step:first-child {
    border-top-color: var(--color-ink-800);
  }

  .consult-step__n {
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-style: italic;
    color: var(--color-bronze-700);
    padding-top: 0.2rem;
  }

  .consult-step__t {
    font-size: 1.0625rem;
    color: var(--color-ink-800);
  }

  .consult-step__d {
    margin-top: 0.5rem;
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--color-body);
  }
</style>
