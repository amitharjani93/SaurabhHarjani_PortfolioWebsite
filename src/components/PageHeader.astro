---
/**
 * Opening block for interior pages. Set on ink so the sticky header reads as
 * a distinct layer, with a hairline grid that echoes the logo's single rule.
 */
import Breadcrumbs from './Breadcrumbs.astro';
import type { Crumb } from '../lib/types';

interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
  numeral?: string;
  crumbs?: Crumb[];
  /** Optional short line set against the title in the right column. */
  statement?: string;
}

const { eyebrow, title, lede, numeral, crumbs = [], statement } = Astro.props;
---

<section class="page-header on-ink relative overflow-hidden bg-ink-900 text-paper">
  <div class="page-header__rules" aria-hidden="true"></div>

  <div class="shell relative">
    {crumbs.length > 0 && <Breadcrumbs items={crumbs} tone="inverse" class="pt-8 lg:pt-10" />}

    <div
      class:list={[
        'grid gap-x-12 gap-y-8 pb-(--spacing-section-sm) lg:grid-cols-12',
        crumbs.length > 0 ? 'pt-10 lg:pt-16' : 'pt-16 lg:pt-24',
      ]}
    >
      <div class="lg:col-span-7">
        {
          (eyebrow || numeral) && (
            <div class="mb-7 flex items-baseline gap-5">
              {numeral && (
                <span class="font-display text-h3 leading-none text-bronze-400 nums-tabular" aria-hidden="true">
                  {numeral}
                </span>
              )}
              {eyebrow && <span class="eyebrow eyebrow-inverse">{eyebrow}</span>}
            </div>
          )
        }

        <h1 class="text-h1 text-paper optical-left">{title}</h1>

        {lede && <p class="mt-7 max-w-[46ch] text-lead text-paper/70">{lede}</p>}
      </div>

      {
        statement && (
          <div class="flex items-end lg:col-span-4 lg:col-start-9">
            <p class="border-l border-bronze-500 pl-6 font-display text-h4 leading-snug text-paper/85 italic">
              {statement}
            </p>
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  /* Four hairlines aligned to the grid — the only ornament on this surface. */
  .page-header__rules {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(to right, rgb(255 255 255 / 0.055) 1px, transparent 1px);
    background-size: 25% 100%;
    mask-image: linear-gradient(to bottom, transparent, black 22%, black 100%);
  }

  @media (max-width: 767px) {
    .page-header__rules {
      background-size: 50% 100%;
    }
  }
</style>
