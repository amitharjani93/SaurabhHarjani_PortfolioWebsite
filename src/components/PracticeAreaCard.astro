---
/**
 * Practice areas are presented as editorial rows rather than a grid of
 * identical cards: a large numeral, a pulled statement and a hairline rule.
 * `variant="feature"` gives the first area more room, so the set reads as a
 * composed sequence instead of three interchangeable boxes.
 */
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import { url } from '../lib/url';

interface Props {
  area: CollectionEntry<'practice-areas'>;
  variant?: 'feature' | 'row';
  /** Number of service categories to preview. */
  serviceCount?: number;
}

const { area, variant = 'row', serviceCount = variant === 'feature' ? 4 : 3 } = Astro.props;
const { title, summary, statement, numeral, services } = area.data;
const href = url(`/practice-areas/${area.id}`);
---

<article class:list={['pa-row', `pa-row--${variant}`]}>
  <a href={href} class="pa-row__hit" aria-label={`${title} — practice area`}></a>

  <div class="pa-row__numeral" aria-hidden="true">{numeral}</div>

  <div class="pa-row__body">
    <h3 class="pa-row__title">{title}</h3>

    {variant === 'feature' && <p class="pa-row__statement">{statement}</p>}

    <p class="pa-row__summary">{summary}</p>

    {
      services.length > 0 && (
        <ul class="pa-row__services">
          {services.slice(0, serviceCount).map((service) => (
            <li>{service.title}</li>
          ))}
          {services.length > serviceCount && <li class="pa-row__services-more">and more</li>}
        </ul>
      )
    }
  </div>

  <div class="pa-row__action">
    <span class="pa-row__link">
      <span>View area</span>
      <Icon name="arrow-right" size={16} />
    </span>
  </div>
</article>

<style>
  .pa-row {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem 2.5rem;
    padding-block: clamp(2rem, 4vw, 3.25rem);
    border-top: 1px solid var(--color-stone-200);
    transition: border-color 400ms var(--ease-out-soft);
  }

  .pa-row:last-child {
    border-bottom: 1px solid var(--color-stone-200);
  }

  .pa-row:hover {
    border-top-color: var(--color-ink-800);
  }

  /* One full-row hit area keeps the whole block clickable without nesting
     interactive elements inside a link. */
  .pa-row__hit {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .pa-row__numeral {
    font-family: var(--font-display);
    font-size: 0.8125rem;
    letter-spacing: 0.06em;
    color: var(--color-bronze-600);
    font-variant-numeric: tabular-nums;
    padding-top: 0.35rem;
  }

  .pa-row__title {
    font-size: var(--text-h3);
    line-height: var(--text-h3--line-height);
    color: var(--color-ink-800);
    transition: color 300ms var(--ease-out-soft);
  }

  .pa-row:hover .pa-row__title {
    color: var(--color-ink-600);
  }

  .pa-row__statement {
    margin-top: 1rem;
    font-family: var(--font-display);
    font-size: var(--text-h4);
    font-style: italic;
    line-height: 1.45;
    color: var(--color-ink-700);
    max-width: 32ch;
  }

  .pa-row__summary {
    margin-top: 1rem;
    max-width: 54ch;
    color: var(--color-body);
  }

  .pa-row__services {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0;
    margin-top: 1.4rem;
    font-size: var(--text-caption);
    color: var(--color-muted);
  }

  .pa-row__services li + li::before {
    content: '·';
    margin-inline: 0.7rem;
    color: var(--color-stone-400);
  }

  .pa-row__services-more {
    font-style: italic;
  }

  .pa-row__action {
    display: flex;
    align-items: flex-start;
  }

  .pa-row__link {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding-bottom: 0.35rem;
    border-bottom: 1px solid var(--color-bronze-500);
    font-size: var(--text-caption);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-800);
    white-space: nowrap;
  }

  .pa-row__link svg {
    transition: transform 340ms var(--ease-out-soft);
  }

  .pa-row:hover .pa-row__link svg {
    transform: translateX(5px);
  }

  /* --- Tablet and up ------------------------------------------------------- */
  @media (min-width: 768px) {
    .pa-row {
      grid-template-columns: 4rem minmax(0, 1fr) auto;
      align-items: start;
    }

    .pa-row__action {
      align-items: center;
      align-self: center;
    }
  }

  @media (min-width: 1024px) {
    .pa-row--feature .pa-row__title {
      font-size: var(--text-h2);
      line-height: var(--text-h2--line-height);
    }
  }
</style>
