---
import Portrait from './Portrait.astro';
import Icon from './Icon.astro';
import { site } from '../config/site';
import { url } from '../lib/url';

const credentialCount =
  site.profile.education.length + site.profile.qualifications.length + site.profile.memberships.length;
---

<section class="bg-paper py-(--spacing-section)">
  <div class="shell">
    <div class="grid items-center gap-x-16 gap-y-12 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <Portrait ratio="aspect-[4/5]" class="max-w-sm lg:max-w-none" />
      </div>

      <div class="lg:col-span-6 lg:col-start-7">
        <span class="eyebrow">Professional profile</span>

        <h2 class="mt-6 text-h2 max-w-[16ch]">{site.name}</h2>
        <p class="mt-3 text-caption tracking-[0.16em] uppercase text-bronze-700">{site.title}</p>

        <p class="mt-8 max-w-[52ch] text-lead text-body">{site.profile.summary}</p>

        <dl class="mt-10 grid gap-x-10 gap-y-6 border-t border-stone-200 pt-8 sm:grid-cols-2">
          <div>
            <dt class="profile-meta__label">Areas of focus</dt>
            <dd class="profile-meta__value">Intellectual property · Property · Civil</dd>
          </div>

          {
            site.bar.council ? (
              <div>
                <dt class="profile-meta__label">Bar enrolment</dt>
                <dd class="profile-meta__value">{site.bar.council}</dd>
              </div>
            ) : credentialCount > 0 ? (
              <div>
                <dt class="profile-meta__label">Qualifications</dt>
                <dd class="profile-meta__value">Set out in full on the profile page</dd>
              </div>
            ) : (
              <div>
                <dt class="profile-meta__label">Engagement</dt>
                <dd class="profile-meta__value">Direct, with a single point of contact</dd>
              </div>
            )
          }
        </dl>

        <a href={url('/profile')} class="link-rule mt-9">
          Read the full profile
          <Icon name="arrow-right" size={16} />
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .profile-meta__label {
    font-size: var(--text-micro);
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .profile-meta__value {
    margin-top: 0.6rem;
    font-family: var(--font-display);
    font-size: 1.0625rem;
    color: var(--color-ink-800);
  }
</style>
