---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import { url } from '../lib/url';
import { formatDate, isoDate, readingTime } from '../lib/format';

interface Props {
  entry: CollectionEntry<'insights'>;
  variant?: 'row' | 'stacked';
  /** Use 2 when the cards follow the page h1 directly, 3 under a section heading. */
  headingLevel?: 2 | 3;
}

const { entry, variant = 'row', headingLevel = 3 } = Astro.props;
const { title, description, category, publishDate, sample } = entry.data;
const minutes = readingTime(entry.body ?? '');
const Heading = `h${headingLevel}` as 'h2' | 'h3';
---

<article class:list={['insight', `insight--${variant}`]}>
  <a href={url(`/insights/${entry.id}`)} class="insight__hit">
    <span class="sr-only">{title}</span>
  </a>

  <div class="insight__meta">
    <span class="insight__category">{category}</span>
    <time datetime={isoDate(publishDate)}>{formatDate(publishDate)}</time>
    <span aria-hidden="true">·</span>
    <span>{minutes} min read</span>
    {sample && <span class="insight__sample">Sample</span>}
  </div>

  <Heading class="insight__title">{title}</Heading>
  <p class="insight__description">{description}</p>

  <span class="insight__more">
    <span>Read</span>
    <Icon name="arrow-right" size={15} />
  </span>
</article>

<style>
  .insight {
    position: relative;
    display: grid;
    align-content: start;
    padding-block: clamp(1.75rem, 3vw, 2.5rem);
    border-top: 1px solid var(--color-stone-200);
    transition: border-color 350ms var(--ease-out-soft);
  }

  .insight:hover {
    border-top-color: var(--color-ink-800);
  }

  .insight--stacked {
    padding-block: 0;
    border-top: 0;
  }

  .insight__hit {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .insight__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.55rem;
    font-size: var(--text-micro);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .insight__category {
    color: var(--color-bronze-700);
    font-weight: 500;
    letter-spacing: 0.16em;
  }

  .insight__category::after {
    content: '·';
    margin-left: 0.55rem;
    color: var(--color-stone-400);
  }

  .insight__sample {
    padding: 0.2rem 0.5rem;
    border: 1px solid var(--color-stone-300);
    color: var(--color-muted);
    letter-spacing: 0.14em;
  }

  .insight__title {
    margin-top: 1rem;
    font-size: var(--text-h3);
    line-height: var(--text-h3--line-height);
    max-width: 26ch;
    color: var(--color-ink-800);
    transition: color 300ms var(--ease-out-soft);
  }

  .insight:hover .insight__title {
    color: var(--color-ink-600);
  }

  .insight__description {
    margin-top: 0.9rem;
    max-width: 52ch;
    color: var(--color-body);
  }

  .insight__more {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin-top: 1.5rem;
    font-size: var(--text-caption);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-800);
  }

  .insight__more svg {
    transition: transform 320ms var(--ease-out-soft);
  }

  .insight:hover .insight__more svg {
    transform: translateX(4px);
  }
</style>
