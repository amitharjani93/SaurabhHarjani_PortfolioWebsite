---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import ConsultationForm from '../components/ConsultationForm.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import Icon from '../components/Icon.astro';
import { faqsFor } from '../config/faq';
import { site, hasContactDetails, formattedAddress } from '../config/site';
import { url } from '../lib/url';

const address = formattedAddress();
const faqs = faqsFor('general').slice(0, 4);

const whatsappHref =
  site.contact.whatsappEnabled && site.contact.whatsapp ? `https://wa.me/${site.contact.whatsapp}` : null;
---

<BaseLayout
  title="Request a Consultation"
  description="Send a short summary of your matter to arrange a consultation. Inquiries are reviewed personally. Submitting an inquiry does not create an advocate-client relationship."
  path="/contact"
>
  <PageHeader
    eyebrow="Consultation"
    title="Request a consultation."
    lede="Describe the matter in a few lines. You will receive a reply setting out whether it falls within the practice and, if so, what a first consultation would involve."
    crumbs={[{ label: 'Contact' }]}
  />

  <section class="bg-paper py-(--spacing-section)">
    <div class="shell">
      <div class="grid gap-x-16 gap-y-16 lg:grid-cols-12">
        <!-- ------------------------------------------------------- Form -->
        <div class="lg:col-span-7">
          <h2 class="text-h3">Inquiry</h2>
          <p class="mt-4 max-w-[52ch] text-body">
            Fields marked as optional can be left blank. Please keep the description brief — the
            detail is better handled in conversation.
          </p>

          <div class="mt-10">
            <ConsultationForm />
          </div>
        </div>

        <!-- ---------------------------------------------------- Details -->
        <aside class="lg:col-span-4 lg:col-start-9">
          <div class="lg:sticky lg:top-28">
            <h2 class="text-micro font-medium tracking-[0.18em] uppercase text-bronze-700">Direct contact</h2>

            {
              hasContactDetails || whatsappHref ? (
                <address class="mt-6 grid gap-0 not-italic border-t border-ink-800">
                  {site.contact.phone && (
                    <a href={`tel:${site.contact.phone.replace(/\s/g, '')}`} class="contact-row">
                      <Icon name="phone" size={17} class="contact-row__icon" />
                      <span>
                        <span class="contact-row__label">Telephone</span>
                        <span class="contact-row__value">{site.contact.phone}</span>
                      </span>
                    </a>
                  )}

                  {site.contact.email && (
                    <a href={`mailto:${site.contact.email}`} class="contact-row">
                      <Icon name="mail" size={17} class="contact-row__icon" />
                      <span>
                        <span class="contact-row__label">Email</span>
                        <span class="contact-row__value break-all">{site.contact.email}</span>
                      </span>
                    </a>
                  )}

                  {whatsappHref && (
                    <a href={whatsappHref} rel="noopener noreferrer" target="_blank" class="contact-row">
                      <Icon name="phone" size={17} class="contact-row__icon" />
                      <span>
                        <span class="contact-row__label">WhatsApp</span>
                        <span class="contact-row__value">Message the practice</span>
                      </span>
                    </a>
                  )}

                  {address.length > 0 && (
                    <span class="contact-row contact-row--static">
                      <Icon name="pin" size={17} class="contact-row__icon" />
                      <span>
                        <span class="contact-row__label">Chambers</span>
                        <span class="contact-row__value">
                          {address.map((line, i) => (
                            <>
                              {i > 0 && <br />}
                              {line}
                            </>
                          ))}
                        </span>
                        {site.contact.address.mapUrl && (
                          <a
                            href={site.contact.address.mapUrl}
                            rel="noopener noreferrer"
                            target="_blank"
                            class="contact-row__map"
                          >
                            View on map
                            <Icon name="arrow-up-right" size={14} />
                          </a>
                        )}
                      </span>
                    </span>
                  )}

                  <span class="contact-row contact-row--static">
                    <Icon name="clock" size={17} class="contact-row__icon" />
                    <span>
                      <span class="contact-row__label">Availability</span>
                      <span class="contact-row__value">{site.contact.availabilityNote}</span>
                    </span>
                  </span>
                </address>
              ) : (
                /* Shown until contact details are set in src/config/site.ts */
                <div class="mt-6 border-t border-ink-800 pt-6">
                  <p class="text-body max-w-[38ch]">
                    Telephone, email and chambers details will be published here. Until then, the
                    inquiry form is the way to get in touch.
                  </p>
                </div>
              )
            }

            <div class="mt-10 border-t border-stone-200 pt-7">
              <h2 class="text-micro font-medium tracking-[0.18em] uppercase text-bronze-700">
                What to have ready
              </h2>
              <ul class="mt-5 grid gap-3 text-sm text-body">
                <li class="ready-item">A short chronology of what happened, with dates</li>
                <li class="ready-item">Any agreement, notice or registration certificate involved</li>
                <li class="ready-item">Correspondence with the other side, if there is any</li>
                <li class="ready-item">Any deadline or hearing date you have been given</li>
              </ul>
              <p class="mt-5 text-caption text-muted max-w-[38ch]">
                Please do not attach documents to your first inquiry. You will be told what to send
                and how, if a review would help.
              </p>
            </div>

            <a href={url('/faq')} class="link-rule mt-9">
              Questions about the process
              <Icon name="arrow-right" size={16} />
            </a>
          </div>
        </aside>
      </div>
    </div>
  </section>

  {
    faqs.length > 0 && (
      <section class="border-t border-stone-200 bg-stone-50 py-(--spacing-section)">
        <div class="shell">
          <div class="grid gap-x-16 gap-y-10 lg:grid-cols-12">
            <div class="lg:col-span-4">
              <span class="eyebrow">Before you send</span>
              <h2 class="mt-6 text-h3 max-w-[16ch]">How an inquiry is handled.</h2>
            </div>
            <div class="lg:col-span-7 lg:col-start-6">
              <FAQAccordion items={faqs} idPrefix="contact-faq" />
            </div>
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .contact-row {
    display: grid;
    grid-template-columns: 1.75rem 1fr;
    gap: 0.85rem;
    align-items: start;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--color-stone-200);
    transition: border-color 300ms var(--ease-out-soft);
  }

  a.contact-row:hover {
    border-bottom-color: var(--color-bronze-500);
  }

  .contact-row__icon {
    margin-top: 0.35rem;
    color: var(--color-bronze-600);
  }

  .contact-row__label {
    display: block;
    font-size: var(--text-micro);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .contact-row__value {
    display: block;
    margin-top: 0.4rem;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-ink-800);
  }

  .contact-row__map {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 2.75rem;
    font-size: var(--text-caption);
    color: var(--color-bronze-700);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .ready-item {
    position: relative;
    padding-left: 1.35rem;
    line-height: 1.6;
  }

  .ready-item::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.7em;
    width: 0.55rem;
    height: 1px;
    background-color: var(--color-bronze-500);
  }
</style>
