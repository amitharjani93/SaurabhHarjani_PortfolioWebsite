# Copy this file to `.env` for local development, or set these as repository
# variables/secrets for the GitHub Actions deployment.
#
# Only variables prefixed with PUBLIC_ are available in the browser.

# ---------------------------------------------------------------------------
# Consultation form endpoint (optional)
# ---------------------------------------------------------------------------
# An HTTPS URL that accepts a JSON POST. Anything works: Formspree, a
# Cloudflare Worker, an AWS Lambda function URL, or a real API once a backend
# exists. Leave it empty and the form falls back to composing a pre-filled
# email in the visitor's own mail client.
#
# See src/services/consultation.ts for the payload shape.
PUBLIC_CONSULTATION_ENDPOINT=

# ---------------------------------------------------------------------------
# Deployment target (build-time only; not exposed to the browser)
# ---------------------------------------------------------------------------
# SITE       Origin the site will be served from.
# BASE_PATH  Sub-path, or "/" for a user site or custom domain.
#
# Project site:  SITE=https://username.github.io   BASE_PATH=/repository-name
# User site:     SITE=https://username.github.io   BASE_PATH=/
# Custom domain: SITE=https://example.com          BASE_PATH=/
SITE=
BASE_PATH=
